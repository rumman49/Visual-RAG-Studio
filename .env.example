# Local development only. Backend binds to 127.0.0.1 by default.
VRS_HOST=127.0.0.1
VRS_PORT=8001
VRS_ENV=development
VRS_DATABASE_URL=sqlite:///./data/visual_rag_studio.db
VRS_DATA_PATH=./data
VRS_CHROMA_PATH=./data/chroma-recovered
VRS_OLLAMA_BASE_URL=http://127.0.0.1:11434
VRS_OLLAMA_EMBEDDING_MODEL=
VRS_EMBEDDING_PROVIDER=sentence_transformers
VRS_SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VRS_SENTENCE_TRANSFORMERS_LOCAL_FILES_ONLY=false
VRS_OLLAMA_GENERATION_MODEL=
VRS_GENERATION_PROVIDER=groq
VRS_GROQ_GENERATION_MODEL=openai/gpt-oss-20b
VRS_HF_GENERATION_MODEL=
VRS_HF_PROVIDER_POLICY=fastest
VRS_HF_TIMEOUT_SECONDS=90
VRS_GENERATION_MAX_TOKENS=512
VRS_GENERATION_TEMPERATURE=0.2
HF_TOKEN=
GROQ_API_KEY=
VRS_OLLAMA_TIMEOUT_SECONDS=90
VRS_MAX_CONTEXT_CHARS=18000
VRS_MAX_UPLOAD_BYTES=10485760
